{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "audiox-telemetry",
	"main": "worker.js",
	"compatibility_date": "2026-11-06",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{
			"pattern": "telemetry.audiox.wklab.net",
			"custom_domain": true
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "http://audiox.local,http://172.31.73.1,http://audiox,http://audiox.lan,http://audiox.wklab.net"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "audiox-telemetry",
			"database_id": "d28ec131-9505-45fd-80bb-49abbec713e5",
			"migrations_dir": "migrations"
		},
		{
			"binding": "audiox_telemetry",
			"database_name": "audiox-telemetry",
			"database_id": "d28ec131-9505-45fd-80bb-49abbec713e5",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "INGEST_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	},
	"observability": {
		"enabled": false
	}
}